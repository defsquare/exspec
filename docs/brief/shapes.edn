;; -------- état :reference — la copie qu'on garde
;; Le scénario est joué deux fois, sur deux exécutions. On garde une copie ; là où les deux diffèrent,
;; la valeur est remplacée par une marque de bruit. Deux endroits qui portaient LA MÊME valeur bruitée
;; reçoivent LA MÊME marque : au rejeu, peu importe la valeur, tant qu'ils restent égaux entre eux.
;; Ce sont les deux seules informations qu'on ne retrouve pas sans rejouer deux fois : le choix de la
;; copie, et le bruit.
{:scenario "unfavorite an article that others favorited too"
 :run      {:target "conduit" :version "d8f34f0" :at "2026-11-10T14:02:11Z" :clock nil}
 :status   :reference
 :proves   ["leaves-favorites"]
 :arrange  [{:call     {:operation "favorite-article"
                        :with      {:slug "how-to-train-your-dragon"} :caller "alice"}
             :response {:status 200 :body {:article {:favoritesCount 2 :favorited true
                                                     :updatedAt [:noise 1]}}}}]
 :act      {:call         {:operation "unfavorite-article"
                           :with      {:slug "how-to-train-your-dragon"} :caller "bob"}
            :response     {:status 200 :body {:article {:favoritesCount 1 :favorited false
                                                        :updatedAt [:noise 1]}}}   ;; même marque : même valeur
            :side-effects [{:observable "database" :on "article_favorite"
                            :added [] :changed []
                            :removed [{"article_id" 5 "user_id" 2}]}]}
 :assert   [{:fact "the caller has favorited the article"             :before true :after false}
            {:fact "the caller has favorited the article" :as "alice" :before true :after true}
            {:shows {:structure "Article" :field [:favoritesCount]}   :before 2    :after 1}]}
;; Un rejeu = une nouvelle copie :played, comparée à la :reference au bruit près. Rien d'autre à stocker.

